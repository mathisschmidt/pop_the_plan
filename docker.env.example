# Pop the Plan: Docker / Portainer settings.
# Copy to `docker.env` (git-ignored), or paste these into Portainer's
# "Environment variables" (Advanced mode) / "Load variables from .env file".
# Required: ADMIN_DEFAULT_PASSWORD and ORIGIN. Everything else shows its default.

# ---- Required ---------------------------------------------------------------
# Admin password used ONLY when the database is created (first start).
# Change it afterwards in the dashboard. Min. 8 characters.
ADMIN_DEFAULT_PASSWORD=change-me-please

# The exact URL used to open the app: scheme + host (+ port when not 80/443).
#   e.g. https://pop.example.com  or  http://192.168.1.20:3000
# Wrong or missing => forms (login!) are rejected as cross-site.
ORIGIN=https://pop.example.com

# ---- Image & container ------------------------------------------------------
IMAGE=pop-the-plan:latest
# Port published on the Docker host, and the address it binds to.
HOST_PORT=3000
HOST_BIND=0.0.0.0
# uid:gid the app runs as. Must be able to write DATA_PATH.
PUID=1000
PGID=1000
# Named volume (default) or an absolute host path, e.g. /srv/pop-the-plan
DATA_PATH=pop-the-plan-data
TZ=UTC

# ---- HTTP server ------------------------------------------------------------
# Port the app listens on inside the container.
PORT=3000
# Max request size (cropped uploads are ~0.5 MB).
BODY_SIZE_LIMIT=5M
# Seconds to finish in-flight requests on stop.
SHUTDOWN_TIMEOUT=30
