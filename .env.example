# SQLite database file. If it does not exist, it is created on first start
# and the admin account is seeded with ADMIN_DEFAULT_PASSWORD.
DATABASE_PATH=./data/pop-the-plan.db

# Admin password used ONLY when the database is created. Change it from the
# dashboard afterwards (Settings > My password). Min. 8 characters.
ADMIN_DEFAULT_PASSWORD=change-me-please

# Where processed ring pictures are stored.
UPLOAD_DIR=./data/uploads

# Drizzle SQL migrations, applied automatically at startup.
MIGRATIONS_DIR=./drizzle

# --- Production only (adapter-node) ---------------------------------------
# Public URL of the app (needed behind a reverse proxy for CSRF checks).
# ORIGIN=https://pop.example.com
# Max request body; cropped uploads are ~0.5 MB, keep some margin.
BODY_SIZE_LIMIT=5M
# PORT=3000
