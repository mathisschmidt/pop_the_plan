# Variables the stack needs.
#
# Plain compose: copy this to .env next to docker-compose.yml.
# Portainer:     set them in the stack's Environment section instead — Portainer
#                does not read this file.

# --- required ---------------------------------------------------------------

# The public URL, scheme included, no trailing slash. Used for CSRF checks and
# Secure cookies. On a LAN with no domain, use the address you actually type
# on the phone:
#   ORIGIN=http://192.168.1.20:3000
ORIGIN=https://pop.example.com

# --- first boot only --------------------------------------------------------

# The admin password set the first time the app starts (min. 8 characters).
# Ignored afterwards; change it in the dashboard (Settings > My password).
ADMIN_DEFAULT_PASSWORD=change-this-before-first-boot

# --- optional ---------------------------------------------------------------

# Where the container is published on the host. The default listens on every
# interface, port 3000. Set BIND_ADDRESS=127.0.0.1 if a reverse proxy on this
# host should be the only thing that can reach it.
# BIND_ADDRESS=0.0.0.0
# HOST_PORT=3000
